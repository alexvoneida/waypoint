# Copy to .env and fill in real values. Never commit .env.

# Phase 0: local Postgres/PostGIS, matches docker-compose.yml defaults.
DATABASE_URL=postgresql://waypoint:waypoint@localhost:5432/waypoint

# Phase 3: map tiles (MapLibre + MapTiler)
# MAPTILER_API_KEY=

# Phase 2: photo storage (Cloudflare R2)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Phase 5: Strava OAuth / activity import.
# Application credentials, from https://www.strava.com/settings/api. These identify
# the application, not any athlete, and are the only Strava values that belong here.
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# Per-athlete access and refresh tokens NEVER live in this file. They are obtained
# per user by the OAuth flow (N-1) and stored encrypted in the database, because
# each one grants access to one person's activities and the app will hold many.
# The key that encrypts them at rest:
# STRAVA_TOKEN_ENCRYPTION_KEY=

# Optional, local development only: a refresh token for your own athlete account,
# so scripts can call the API before the OAuth flow exists. This is a personal
# credential in a file that is not a credential store — delete it once the OAuth
# flow works, and never let application code read it.
# STRAVA_DEV_REFRESH_TOKEN=
